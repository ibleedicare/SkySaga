<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <LangVersion>preview</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkySaga.RakNet\SkySaga.RakNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\Entities.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The item table, linked straight out of the files bundled with client 10414 so it
         cannot drift from the client it targets. Regenerate with
         tools/entity-extract/extract_bundled.py. -->
    <None Include="..\..\Bundled\10414\geodata.json" Link="Data\GeoData.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>